---
import { sanityClient, queries } from "@/lib/sanity";

// Fetch shows from Sanity - now includes images
const shows = await sanityClient.fetch(queries.shows).catch(() => []);

const defaultShows = [
  { name: "La Quijada", image: "" },
  { name: "Juanchy Osuna", image: "" },
  { name: "Lucho Ciganda", image: "" },
];

const showsList = shows.length > 0
  ? shows.map((s: any) => ({
      name: s.artist,
      image: s.photo
    }))
  : defaultShows;
---

<section id='shows' data-section class='section scroll-mt-20'>
  <div class='container'>
    <h2 class='section-title text-center text-crema'>Reviví los shows de la Olimpiada</h2>
    <p class='text-xl text-center mb-10 text-crema/70 max-w-2xl mx-auto'>
      Artistas que acompañaron el fuego con la mejor música en vivo.
    </p>
    
    {showsList.length > 0 ? (
    <div class='grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6'>
      {showsList.map((show: any, index: number) => (
        <div class='group relative bg-sombra/40 rounded-xl overflow-hidden border border-fuego/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(194,65,12,0.3)] hover:border-fuego/60'>
          
          <div class='absolute inset-0 bg-gradient-to-br from-fuego/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300' />

          {show.image ? (
            <div class='w-full aspect-square overflow-hidden relative'>
              <img 
                src={show.image} 
                alt={show.name}
                class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-110'
                loading='lazy'
              />
              <div class='absolute inset-0 bg-gradient-to-t from-carbon via-transparent to-transparent opacity-80' />
            </div>
          ) : (
            <div class='w-full aspect-square flex items-center justify-center bg-sombra/60 relative'>
              <span class='text-crema/30 font-ui italic'>Sin imagen</span>
              <div class='absolute inset-0 bg-gradient-to-t from-carbon to-transparent opacity-80' />
            </div>
          )}
          
          <div class='absolute bottom-0 inset-x-0 p-4 text-center transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300'>
            <h3 class='font-ui text-lg font-bold text-crema group-hover:text-fuego transition-colors drop-shadow-md'>
              {show.name}
            </h3>
          </div>
        </div>
      ))}
    </div>
    ) : (
    <div class='text-center py-12'>
      <p class='text-crema/50 font-ui italic text-lg'>Próximamente anunciaremos la grilla de artistas...</p>
    </div>
    )}
  </div>
</section>
