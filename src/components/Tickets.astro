---

<section id='entradas' data-section class='section scroll-mt-20'>
  <div class='container text-center'>
    <h2 class='section-title'>Entrada</h2>
    <!-- <div class='mt-4 grid grid-cols-1 sm:grid-cols-2 gap-8'>
      {tickets.map((ticket) => <TicketCard {...ticket} />)}
    </div> -->
    <div
      class='mt-6 max-w-3xl mx-auto bg-amber-100/50 border border-amber-200/40 rounded-2xl p-1'
    >
      <div
        class='rounded-2xl border border-white/15 bg-white/5 p-6 shadow-lg backdrop-blur-sm text-left flex flex-col gap-4'
      >
        <div class='space-y-2'>
          <p
            class='text-sm font-semibold uppercase tracking-[0.15em] text-amber-400'
          >
            Entrada libre y gratuita
          </p>
          <h3 class='text-2xl font-bold'>Sumate a la Olimpiada de Asadores</h3>
          <p class='text-base /80'>
            No tenes que pagar ingreso. Registrate para ayudarnos con la
            organizacion y asegura tus sandwiches con descuento anticipado.
          </p>
        </div>
        <div class='flex flex-col sm:flex-row gap-3'>
          <a
            href={event.ticketUrl}
            target='_blank'
            rel='noreferrer'
            class='inline-flex items-center justify-center rounded-full bg-amber-400 px-5 py-2.5 text-sm font-semibold text-gray-900 shadow-lg shadow-amber-500/30 transition hover:translate-y-[-1px] hover:bg-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200'
          >
            Adquirir ingreso
          </a>
          <a
            href={event.ticketUrl}
            target='_blank'
            rel='noreferrer'
            class='inline-flex items-center justify-center rounded-full border border-white/25 px-5 py-2.5 text-sm font-semibold transition hover:border-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200'
          >
            Comprar sandwiches con descuento
          </a>
        </div>
      </div>
    </div>
